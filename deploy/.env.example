# Portal UMA — configuracao de producao (copie para deploy/.env e preencha).
# NUNCA versionar o .env preenchido nem o arquivo de segredo do Drive.

# Dominio publico (Caddy emite o certificado para ele).
DOMAIN=portal.universodasmangueiras.com.br

# Portas publicas (padrao producao). Para stack de teste local use
# HTTP_PORT=8180 / HTTPS_PORT=8444 e PROJECT=uma-vpstest.
#HTTP_PORT=80
#HTTPS_PORT=443
#PROJECT=portal-uma

# Banco PostgreSQL interno (senha forte gerada na instalacao; min. 16 chars).
POSTGRES_DB=portal_uma
POSTGRES_USER=portal_uma
POSTGRES_PASSWORD=TROQUE-por-senha-forte-aleatoria

# MFA obrigatorio p/ SuperAdmin (true recomendado em producao).
ENFORCE_SUPERADMIN_MFA=true

# Sincronizacao ERP (Google Drive, a cada 600s — so esta instancia roda o loop).
ERP_SYNC_ENABLED=true
ERP_SYNC_INTERVAL_SECONDS=600
GOOGLE_DRIVE_FOLDER_ID=ID_DA_PASTA_NO_DRIVE

# Caminho local do JSON da conta de servico (montado read-only; nao versionado).
DRIVE_SA_FILE=./secrets/uma-drive-sa.json

# Retencao dos dumps diarios (dias) em deploy/backups/.
BACKUP_RETENTION_DAYS=14
