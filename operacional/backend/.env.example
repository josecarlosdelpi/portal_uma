# Somente desenvolvimento local; nunca reutilizar credenciais de teste em producao.
DATABASE_URL=postgresql+psycopg://portal_dev:local_only_change_me@127.0.0.1:5439/portal_uma_dev
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Configurar depois de selecionar o provedor de identidade.
# Sem esses valores, qualquer rota protegida recusa o acesso.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Integracao ERP (opcional — somente leitura da pasta privada DadosUMA).
ERP_SYNC_ENABLED=false
ERP_SYNC_INTERVAL_SECONDS=600
GOOGLE_DRIVE_FOLDER_ID=
# Caminho local para o JSON da conta de servico (arquivo fora do repositorio).
GOOGLE_SERVICE_ACCOUNT_JSON=
ERP_DRIVE_VENDAS_NAME=vendas.csv
ERP_DRIVE_DEVOLUCOES_NAME=devolucoes.csv
